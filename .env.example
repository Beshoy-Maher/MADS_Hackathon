# Copy to .env and edit. Every value is a placeholder or a safe default.

# Model: ollama (local, open-weight) or none (deterministic TEMPLATE text only)
LLM_PROVIDER=ollama
# http://ollama:11434 inside docker compose, http://localhost:11434 without docker
LLM_BASE_URL=http://localhost:11434
# Small open-weight model. Smaller: qwen3:1.7b or qwen3:0.6b
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=120
# USD per 1M tokens. 0 for a local model.
LLM_COST_PER_MTOK=0

# Evidence search uses free public APIs (GitHub, Hacker News), no keys needed
RESEARCH_ONLINE=true
# Optional: raises GitHub's search rate limit. Placeholder only, never commit a real token.
GITHUB_TOKEN=
HTTP_TIMEOUT_SECONDS=15

# App
APP_PORT=8000
# Optional: when set, gate decisions and approvals need this token (X-Founder-Token header)
FOUNDER_TOKEN=
# Only "mock" is implemented. There is no live payment mode.
PAYMENT_MODE=mock
