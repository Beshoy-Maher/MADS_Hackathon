# Copy to .env and change what you need. Every value is a placeholder or a safe default.

# Model provider: ollama | openai_compatible | none (deterministic fallback only)
LLM_PROVIDER=ollama
# Inside docker compose. Use http://localhost:11434 when running without docker.
LLM_BASE_URL=http://ollama:11434
# Local open-weight models, one per kind of work (all Apache-2.0, served by Ollama).
# Writer: research, analysis, product and every text the founder reads (Qwen3-30B-A3B-Instruct-2507, MoE, 3.3B active)
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
# Fast: intake (brief to fields)
LLM_FAST_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Judge: the two safety judges (temperature 0)
LLM_JUDGE_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Critic: devil's advocate in the debate before each gate (a different model family from the writer)
LLM_CRITIC_MODEL=gpt-oss:20b
# Used when a role's model is not downloaded or cannot be loaded (e.g. not enough memory). Small laptop: set every model above to qwen3:4b-instruct-2507-q4_K_M
LLM_FALLBACK_MODELS=qwen3:4b-instruct-2507-q4_K_M,qwen3:4b-instruct,qwen3:4b,qwen3:1.7b
# Only for a free-tier OpenAI-compatible endpoint. Leave empty for Ollama.
LLM_API_KEY=
# Faster option for a slow laptop: an open-weight model on a free-tier OpenAI-compatible endpoint (still $0, needs internet).
# Uncomment and fill in; the local Ollama model stays the default and the fallback.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-free-tier-endpoint.example/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=your-free-tier-key
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.3
# Debate before each gate: critic vs. authors (informs the founder, never changes a gate)
DEBATE=true
# USD per 1M tokens. 0 for a local model.
LLM_COST_PER_MTOK=0

# Research uses free public sources, no keys needed
RESEARCH_ONLINE=true
RESEARCH_SOURCES=hackernews,reddit,github,stackexchange
# Optional, raises GitHub search rate limits. Placeholder only.
GITHUB_TOKEN=
HTTP_TIMEOUT_SECONDS=8

# App
APP_PORT=8000
# Optional: require this token for gate decisions and approvals (set it when the app is reachable by others)
FOUNDER_TOKEN=
