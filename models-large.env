# Optional larger open-weight models (all Apache-2.0) for a machine with 32+ GB RAM or an NVIDIA GPU.
#   docker compose --env-file models-large.env up
#   with a GPU: docker compose --env-file models-large.env -f docker-compose.yml -f docker-compose.gpu.yml up
# Downloads about 34 GB once (the 4B model first, so the app is usable within minutes).
# A model that is missing or cannot be loaded hands over to qwen3:4b-instruct-2507-q4_K_M.
# Writer: Qwen3-30B-A3B-Instruct-2507 (mixture of experts, 3.3B active), 18 GB
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_FAST_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_JUDGE_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Critic: OpenAI gpt-oss-20b, a different model family from the writer, 14 GB
LLM_CRITIC_MODEL=gpt-oss:20b
